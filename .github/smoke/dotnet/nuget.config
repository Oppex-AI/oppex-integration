<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only the local folder feed the workflow fills with the packed .nupkg.
         nuget.org is cleared so a restore cannot silently succeed against an
         already-published package instead of the one under test. -->
    <clear />
    <add key="local" value="local-feed" />
  </packageSources>
</configuration>
