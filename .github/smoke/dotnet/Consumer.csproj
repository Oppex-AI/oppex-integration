<Project Sdk="Microsoft.NET.Sdk">

  <!-- An isolated consumer, deliberately outside dotnet/ and deliberately a
       PackageReference rather than a ProjectReference: it resolves the packed
       .nupkg from the local feed, so a file missing from the package fails here
       rather than on NuGet. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The workflow passes the version under test, so this file never has to
         be edited for a release. -->
    <OppexSdkVersion Condition="'$(OppexSdkVersion)' == ''">1.0.0</OppexSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oppex.Integration.Sdk" Version="$(OppexSdkVersion)" />
  </ItemGroup>

</Project>
