@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Threads is a PUBLIC link dependency, so a consumer needs it resolved before the
# exported target is usable.
find_dependency(Threads)

# libcurl is linked PRIVATE, which keeps it out of a consumer's include path.
# A static build still records it as a link-only requirement, so the exported
# target references CURL::libcurl and it has to exist when this file is read.
find_dependency(CURL)

include("${CMAKE_CURRENT_LIST_DIR}/oppex-sdk-targets.cmake")

check_required_components(oppex-sdk)
